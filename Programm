        if payload == "1":
            client.publish("SFB/Aktor/P3", "1")
        else:
            client.publish("SFB/Aktor/P3", "0")

   

    if topic == "Step_11" and payload == "1":
        client.publish("SFB/Aktor/P4", "1")

    if topic == "Step_11" and payload == "0":
        client.publish("SFB/Aktor/P4", "0")

#  Startphase ----------------------------------------------------------------------------------------------------
    if topic == "SFB/Sensor/S2" and payload == "1":
        client.publish("Vorwaesche","1")

    if topic == "SFB/Sensor/S2" and payload == "0":
        client.publish("Vorwaesche","0")


# Phase 1 – Vorwäsche ----------------------------------------------------------------------------------------------------


    
    if topic == "SFB/Sensor/S1" and payload == "1"and sensor_data.get("Step_1") == "1":
        client.publish("SFB/Aktor/Q1", "1")
        client.publish("SFB/Aktor/Y3", "1")
        client.publish("Step_1", "0")
